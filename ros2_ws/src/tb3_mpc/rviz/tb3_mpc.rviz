Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Value: false
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        Depth: 5
      Size (m): 0.03
      Style: Flat Squares
      Color Transformer: FlatColor
      Color: 255; 255; 0
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Reference
      Enabled: true
      Topic:
        Value: /mpc/reference_path
        Durability Policy: Transient Local
      Color: 46; 204; 113
      Line Style: Lines
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Actual
      Enabled: true
      Topic:
        Value: /mpc/actual_path
      Color: 52; 152; 219
      Line Style: Billboards
      Line Width: 0.02
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Predicted (MPC horizon)
      Enabled: true
      Topic:
        Value: /mpc/predicted_path
      Color: 231; 76; 60
      Line Style: Billboards
      Line Width: 0.015
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Obstacles (inflated)
      Enabled: true
      Topic:
        Value: /obstacles_markers
      Value: true
  Global Options:
    Background Color: 40; 40; 40
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 120
      X: 0
      Y: 0
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
