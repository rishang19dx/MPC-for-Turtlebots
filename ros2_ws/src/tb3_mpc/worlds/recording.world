<?xml version="1.0"?>
<!-- Floor with a 0.5 m grid (axes thicker) + a fixed oblique camera that saves
     every frame to /tmp/tb3_mpc_frames (experiments/record_gazebo.sh). -->
<sdf version="1.6">
  <world name="default">
    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <shadows>false</shadows>
      <background>0.92 0.93 0.95 1</background>
    </scene>
    <light name="key" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.65 0.65 0.65 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.3 0.4 -1</direction>
    </light>

    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <surface><friction><ode><mu>100</mu><mu2>50</mu2></ode></friction></surface></collision>
        <visual name="v"><cast_shadows>false</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material><ambient>0.86 0.87 0.88 1</ambient><diffuse>0.86 0.87 0.88 1</diffuse></material></visual>
        <visual name="gx0"><pose>0 -3.0 0.0015 0 0 0</pose><cast_shadows>false</cast_shadows>
          <geometry><box><size>6.0 0.012 0.001</size></box></geometry>
          <material><ambient>0.45 0.47 0.5 1</ambient><diffuse>0.45 0.47 0.5 1</diffuse></material></visual>
        <visual name="gy0"><pose>-3.0 0 0.0015 0 0 0</pose><cast_shadows>false</cast_shadows>
          <geometry><box><size>0.012 6.0 0.001</size></box></geometry>
          <material><ambient>0.45 0.47 0.5 1</ambient><diffuse>0.45 0.47 0.5 1</diffuse></material></visual>
        <visual name="gx1"><pose>0 -2.5 0.0015 0 0 0</pose><cast_shadows>false</cast_shadows>
          <geometry><box><size>6.0 0.012 0.001</size></box></geometry>
          <material><ambient>0.45 0.47 0.5 1</ambient><diffuse>0.45 0.47 0.5 1</diffuse></material></visual>
        <visual name="gy1"><pose>-2.5 0 0.0015 0 0 0</pose><cast_shadows>false</cast_shadows>
          <geometry><box><size>0.012 6.0 0.001</size></box></geometry>
          <material><ambient>0.45 0.47 0.5 1</ambient><diffuse>0.45 0.47 0.5 1</diffuse></material></visual>
        <visual name="gx2"><pose>0 -2.0 0.0015 0 0 0</pose><cast_shadows>false</cast_shadows>
          <geometry><box><size>6.0 0.012 0.001</size></box></geometry>
          <material><ambient>0.45 0.47 0.5 1</ambient><diffuse>0.45 0.47 0.5 1</diffuse></material></visual>
        <visual name="gy2"><pose>-2.0 0 0.0015 0 0 0</pose><cast_shadows>false</cast_shadows>
          <geometry><box><size>0.012 6.0 0.001</size></box></geometry>
          <material><ambient>0.45 0.47 0.5 1</ambient><diffuse>0.45 0.47 0.5 1</diffuse></material></visual>
        <visual name="gx3"><pose>0 -1.5 0.0015 0 0 0</pose><cast_shadows>false</cast_shadows>
          <geometry><box><size>6.0 0.012 0.001</size></box></geometry>
          <material><ambient>0.45 0.47 0.5 1</ambient><diffuse>0.45 0.47 0.5 1</diffuse></material></visual>
        <visual name="gy3"><pose>-1.5 0 0.0015 0 0 0</pose><cast_shadows>false</cast_shadows>
          <geometry><box><size>0.012 6.0 0.001</size></box></geometry>
          <material><ambient>0.45 0.47 0.5 1</ambient><diffuse>0.45 0.47 0.5 1</diffuse></material></visual>
        <visual name="gx4"><pose>0 -1.0 0.0015 0 0 0</pose><cast_shadows>false</cast_shadows>
          <geometry><box><size>6.0 0.012 0.001</size></box></geometry>
          <material><ambient>0.45 0.47 0.5 1</ambient><diffuse>0.45 0.47 0.5 1</diffuse></material></visual>
        <visual name="gy4"><pose>-1.0 0 0.0015 0 0 0</pose><cast_shadows>false</cast_shadows>
          <geometry><box><size>0.012 6.0 0.001</size></box></geometry>
          <material><ambient>0.45 0.47 0.5 1</ambient><diffuse>0.45 0.47 0.5 1</diffuse></material></visual>
        <visual name="gx5"><pose>0 -0.5 0.0015 0 0 0</pose><cast_shadows>false</cast_shadows>
          <geometry><box><size>6.0 0.012 0.001</size></box></geometry>
          <material><ambient>0.45 0.47 0.5 1</ambient><diffuse>0.45 0.47 0.5 1</diffuse></material></visual>
        <visual name="gy5"><pose>-0.5 0 0.0015 0 0 0</pose><cast_shadows>false</cast_shadows>
          <geometry><box><size>0.012 6.0 0.001</size></box></geometry>
          <material><ambient>0.45 0.47 0.5 1</ambient><diffuse>0.45 0.47 0.5 1</diffuse></material></visual>
        <visual name="gx6"><pose>0 0.0 0.0015 0 0 0</pose><cast_shadows>false</cast_shadows>
          <geometry><box><size>6.0 0.025 0.001</size></box></geometry>
          <material><ambient>0.45 0.47 0.5 1</ambient><diffuse>0.45 0.47 0.5 1</diffuse></material></visual>
        <visual name="gy6"><pose>0.0 0 0.0015 0 0 0</pose><cast_shadows>false</cast_shadows>
          <geometry><box><size>0.025 6.0 0.001</size></box></geometry>
          <material><ambient>0.45 0.47 0.5 1</ambient><diffuse>0.45 0.47 0.5 1</diffuse></material></visual>
        <visual name="gx7"><pose>0 0.5 0.0015 0 0 0</pose><cast_shadows>false</cast_shadows>
          <geometry><box><size>6.0 0.012 0.001</size></box></geometry>
          <material><ambient>0.45 0.47 0.5 1</ambient><diffuse>0.45 0.47 0.5 1</diffuse></material></visual>
        <visual name="gy7"><pose>0.5 0 0.0015 0 0 0</pose><cast_shadows>false</cast_shadows>
          <geometry><box><size>0.012 6.0 0.001</size></box></geometry>
          <material><ambient>0.45 0.47 0.5 1</ambient><diffuse>0.45 0.47 0.5 1</diffuse></material></visual>
        <visual name="gx8"><pose>0 1.0 0.0015 0 0 0</pose><cast_shadows>false</cast_shadows>
          <geometry><box><size>6.0 0.012 0.001</size></box></geometry>
          <material><ambient>0.45 0.47 0.5 1</ambient><diffuse>0.45 0.47 0.5 1</diffuse></material></visual>
        <visual name="gy8"><pose>1.0 0 0.0015 0 0 0</pose><cast_shadows>false</cast_shadows>
          <geometry><box><size>0.012 6.0 0.001</size></box></geometry>
          <material><ambient>0.45 0.47 0.5 1</ambient><diffuse>0.45 0.47 0.5 1</diffuse></material></visual>
        <visual name="gx9"><pose>0 1.5 0.0015 0 0 0</pose><cast_shadows>false</cast_shadows>
          <geometry><box><size>6.0 0.012 0.001</size></box></geometry>
          <material><ambient>0.45 0.47 0.5 1</ambient><diffuse>0.45 0.47 0.5 1</diffuse></material></visual>
        <visual name="gy9"><pose>1.5 0 0.0015 0 0 0</pose><cast_shadows>false</cast_shadows>
          <geometry><box><size>0.012 6.0 0.001</size></box></geometry>
          <material><ambient>0.45 0.47 0.5 1</ambient><diffuse>0.45 0.47 0.5 1</diffuse></material></visual>
        <visual name="gx10"><pose>0 2.0 0.0015 0 0 0</pose><cast_shadows>false</cast_shadows>
          <geometry><box><size>6.0 0.012 0.001</size></box></geometry>
          <material><ambient>0.45 0.47 0.5 1</ambient><diffuse>0.45 0.47 0.5 1</diffuse></material></visual>
        <visual name="gy10"><pose>2.0 0 0.0015 0 0 0</pose><cast_shadows>false</cast_shadows>
          <geometry><box><size>0.012 6.0 0.001</size></box></geometry>
          <material><ambient>0.45 0.47 0.5 1</ambient><diffuse>0.45 0.47 0.5 1</diffuse></material></visual>
        <visual name="gx11"><pose>0 2.5 0.0015 0 0 0</pose><cast_shadows>false</cast_shadows>
          <geometry><box><size>6.0 0.012 0.001</size></box></geometry>
          <material><ambient>0.45 0.47 0.5 1</ambient><diffuse>0.45 0.47 0.5 1</diffuse></material></visual>
        <visual name="gy11"><pose>2.5 0 0.0015 0 0 0</pose><cast_shadows>false</cast_shadows>
          <geometry><box><size>0.012 6.0 0.001</size></box></geometry>
          <material><ambient>0.45 0.47 0.5 1</ambient><diffuse>0.45 0.47 0.5 1</diffuse></material></visual>
        <visual name="gx12"><pose>0 3.0 0.0015 0 0 0</pose><cast_shadows>false</cast_shadows>
          <geometry><box><size>6.0 0.012 0.001</size></box></geometry>
          <material><ambient>0.45 0.47 0.5 1</ambient><diffuse>0.45 0.47 0.5 1</diffuse></material></visual>
        <visual name="gy12"><pose>3.0 0 0.0015 0 0 0</pose><cast_shadows>false</cast_shadows>
          <geometry><box><size>0.012 6.0 0.001</size></box></geometry>
          <material><ambient>0.45 0.47 0.5 1</ambient><diffuse>0.45 0.47 0.5 1</diffuse></material></visual>
      </link>
    </model>

    <!-- looks at the world origin from above (-y side), ~4.6 m away -->
    <model name="recording_camera">
      <static>true</static>
      <pose>0 -1.3 4.4 0 1.283 1.5708</pose>
      <link name="link">
        <sensor name="camera" type="camera">
          <update_rate>15</update_rate>
          <camera>
            <horizontal_fov>1.15</horizontal_fov>
            <image><width>1280</width><height>720</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>50</far></clip>
            <save enabled="true"><path>/tmp/tb3_mpc_frames</path></save>
          </camera>
          <always_on>true</always_on>
        </sensor>
      </link>
    </model>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
  </world>
</sdf>
